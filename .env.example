# Skopiuj do .env i uzupełnij (np. `set -a; source .env; set +a`)
DJANGO_SECRET_KEY=zmien-mnie
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_CONTACT_EMAIL=kontakt@example.com
DJANGO_DEFAULT_FROM_EMAIL=noreply@example.com
DJANGO_LOG_LEVEL=INFO
DJANGO_DOCUMENT_MAX_UPLOAD_MB=20
DJANGO_SOFTWARE_MAX_UPLOAD_MB=1024
DJANGO_DOCUMENTS_REQUIRE_LOGIN=False
